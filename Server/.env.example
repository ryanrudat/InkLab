# Required for /recognize (handwriting) and as the /make-real fallback.
ANTHROPIC_API_KEY=

# Widget generation (/make-real) uses OpenAI's gpt-6.1-sol when this is set; without it, Claude is used.
OPENAI_API_KEY=

# Optional: force a widget model (any gpt-… id uses OpenAI, anything else Anthropic), e.g. claude-opus-4-8.
# MAKE_REAL_MODEL=

# Optional upstream deadline in milliseconds (defaults to 120 seconds).
ANTHROPIC_TIMEOUT_MS=120000

# Recommended for deployed environments; optional for local development.
INKLAB_PROXY_SECRET=

# Optional locally. Railway supplies PORT automatically.
PORT=8787
